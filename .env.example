# ── NEAR (testnet only) ────────────────────────────────────────────────
# Account the COMMONS contract is deployed to (see scripts/deploy-contract.sh).
# Leave empty to run without on-chain features; the UI says so explicitly.
NEXT_PUBLIC_COMMONS_CONTRACT_ID=commons-pool-26.testnet
# JSON-RPC endpoint used for server-side transaction verification and views.
NEXT_PUBLIC_NEAR_RPC_URL=https://test.rpc.fastnear.com

# ── Database ───────────────────────────────────────────────────────────
# SQLite file path. Defaults to ./data/commons.db (or /tmp/commons.db on Vercel).
COMMONS_DB_PATH=
